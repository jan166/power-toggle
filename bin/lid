#!/bin/sh
# lid — 노트북 뚜껑을 닫아도 잠들지 않게 하는 기능(pmset disablesleep) 토글
#
#   lid          현재 상태 보기
#   lid off      기능 끔  → 닫으면 잠듦 (배터리 절약, macOS 기본)
#   lid on       기능 켬  → 닫아도 계속 깨어 있음
#   lid toggle   on <-> off 왕복
#
# root 권한이 필요하다. /etc/sudoers.d/pmset-lid-toggle 규칙이 있으면 비밀번호 없이,
# 없으면 sudo 비밀번호를 물어본다.

PMSET=/usr/bin/pmset

# 현재 SleepDisabled 값 → "1" 또는 "0"
current() {
	v=$("$PMSET" -g 2>/dev/null | awk '/SleepDisabled/ {print $2; found=1} END {if (!found) print 0}')
	case "$v" in
		1) printf '1' ;;
		*) printf '0' ;;
	esac
}

apply() {
	# 비밀번호 없이 먼저 시도, 안 되면 대화형 sudo로 폴백
	if sudo -n "$PMSET" -a disablesleep "$1" 2>/dev/null; then
		return 0
	fi
	printf 'root 권한이 필요합니다 (sudoers 규칙 없음 → 비밀번호 입력).\n' >&2
	sudo "$PMSET" -a disablesleep "$1"
}

status() {
	if [ "$(current)" = "1" ]; then
		printf '뚜껑 닫힘 방지 : \033[1;33m켜짐\033[0m — 닫아도 안 잠듭니다 (배터리 소모 큼)\n'
	else
		printf '뚜껑 닫힘 방지 : \033[1;32m꺼짐\033[0m — 닫으면 잠듭니다 (macOS 기본)\n'
	fi

	# 참고 지표
	caf_mode=$(cat "${CAFFEINATE_MODE_FILE:-$HOME/.config/caffeinate-toggle/mode}" 2>/dev/null)
	[ -n "$caf_mode" ] || caf_mode="on (shim 미설치)"
	printf 'caffeinate     : %s   (바꾸려면 caf)\n' "$caf_mode"

	dsleep=$("$PMSET" -g 2>/dev/null | awk '/^ displaysleep/ {print $2}')
	printf '화면 꺼짐      : %s분\n' "${dsleep:-?}"

	power=$("$PMSET" -g batt 2>/dev/null | sed -n "s/.*drawing from '\(.*\)'.*/\1/p")
	batt=$("$PMSET" -g batt 2>/dev/null | sed -n 's/.*[[:space:]]\([0-9]\{1,3\}%\);.*/\1/p')
	printf '현재 전원      : %s%s\n' "${power:-?}" "${batt:+  ($batt)}"
}

case "${1:-status}" in
	off | 0 | sleep) apply 0 && status ;;
	on | 1 | nosleep) apply 1 && status ;;
	toggle)
		if [ "$(current)" = "1" ]; then apply 0; else apply 1; fi && status
		;;
	status | "") status ;;
	-h | --help | help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
	*)
		printf 'lid: 알 수 없는 옵션 "%s"\n\n' "$1" >&2
		sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2
		exit 1
		;;
esac
