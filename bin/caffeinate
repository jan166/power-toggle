#!/bin/sh
# A caffeinate shim. Sits ahead of /usr/bin/caffeinate in PATH so the sleep
# assertions that CLI tools create can be controlled by a mode. Change the mode
# with the `caf` command.
#
#   on   : always pass through (stock macOS behavior)
#   off  : always block, exit immediately so the machine can sleep
#   auto : pass through on AC power, block on battery (the default)
#
# One exception: if the invocation wraps a command (`caffeinate -i make build`),
# it always passes through regardless of mode. Blocking it would stop the
# wrapped command from running at all.

REAL=/usr/bin/caffeinate
MODE_FILE="${CAFFEINATE_MODE_FILE:-$HOME/.config/caffeinate-toggle/mode}"

# A non-flag argument means a wrapped command, so run the real binary.
skip=0
for a in "$@"; do
	if [ "$skip" -eq 1 ]; then
		skip=0
		continue
	fi
	case "$a" in
		-t | -w) skip=1 ;;
		-*) ;;
		*) exec "$REAL" "$@" ;;
	esac
done

mode=$(cat "$MODE_FILE" 2> /dev/null) || mode=auto
[ -n "$mode" ] || mode=auto

case "$mode" in
	on)
		exec "$REAL" "$@"
		;;
	off)
		exit 0
		;;
	*)
		# auto: pass through on AC power, block on battery.
		if /usr/bin/pmset -g batt 2> /dev/null | grep -q "AC Power"; then
			exec "$REAL" "$@"
		fi
		exit 0
		;;
esac
